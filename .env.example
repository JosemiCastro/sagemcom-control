# Router
ROUTER_HOST=192.168.0.1
ROUTER_USER=user
ROUTER_PASS=pon_aqui_la_clave_de_la_pegatina
# SHA512 o MD5 (si no sabes, deja AUTO)
ROUTER_ENCRYPTION=AUTO

# Parámetro de bloqueo (ver README paso 0 — discover.py)
# Debe ser un parámetro escribible con la lista de MACs denegadas.
BLOCK_LIST_XPATH=
# Separador de la lista (normalmente "," )
BLOCK_LIST_SEP=,

# Puerto de la app
PORT=8000
